{
  "cleanUrls": true,
  "rewrites": [{"source":"/api/:path*","destination":"https://secret-santa-pepperskay.waw0.amvera.tech/api/:path*"}],
  "headers": [
    {"source":"/api/(.*)","headers":[{"key":"Cache-Control","value":"private, no-store"}]},
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=31536000, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
